    private final ScanCallback scanCallback = new ScanCallback() {
        @Override
        public void onScanResult(int callbackType, ScanResult result) {
            BluetoothDevice device = result.getDevice();
            String name = safeName(device);
            if ((name == null || name.equals("(sem nome)")) && result.getScanRecord() != null) {
                String advertised = result.getScanRecord().getDeviceName();
                if (advertised != null && !advertised.trim().isEmpty()) name = advertised;
            }
            devices.put(safeAddress(device), new DeviceEntry(device, name == null ? "(sem nome)" : name, result.getRssi()));
            runOnUiThread(MainActivity.this::renderDevices);
        }
